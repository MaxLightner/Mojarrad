{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nika Bana portfolio project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "title",
    "details",
    "media",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^nb-[0-9]{4,}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Persian public narrative / WordPress post_content, plain text until reviewed"
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "in-progress",
            "future"
          ]
        },
        "status_description": {
          "type": "string"
        },
        "public_location": {
          "type": "string"
        },
        "area_m2": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "year": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "progress_percent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "sale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "for_sale"
      ],
      "properties": {
        "for_sale": {
          "type": "boolean"
        },
        "price": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cover",
        "gallery"
      ],
      "properties": {
        "cover": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/image"
            }
          ]
        },
        "gallery": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image"
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "approved_for_website"
      ],
      "properties": {
        "stage": {
          "enum": [
            "collecting",
            "review",
            "ready"
          ]
        },
        "approved_for_website": {
          "type": "boolean"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "alt",
        "approved_for_public_use"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^media/nb-[0-9]{4,}/[^/]+\\.(?:webp|avif|jpg|jpeg|png)$"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "approved_for_public_use": {
          "type": "boolean"
        }
      }
    }
  }
}
